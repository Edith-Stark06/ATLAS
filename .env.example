# Copy to .env and adjust for your local setup.
# .env is gitignored — never commit real secrets.

# --- Postgres (consumed by infra/docker-compose.yml) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_password
POSTGRES_DB=atlas
# Non-default ports so ATLAS never collides with other local projects.
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6380

# --- API (apps/api) ---
DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5433/atlas
REDIS_URL=redis://localhost:6380/0
API_HOST=0.0.0.0
API_PORT=8000
# Auto-reload spawns a child process that can outlive its parent and keep
# serving stale code; opt in only when you want it.
API_RELOAD=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Auth (apps/api) ---
# Signs access tokens. The API refuses to start with this value when
# ENVIRONMENT is anything other than "development" — generate a real one:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=60

# The first admin account, created by `python -m app.seed` only when no users
# exist yet. Also refused in production while still at the default.
BOOTSTRAP_ADMIN_EMAIL=admin@atlas.local
BOOTSTRAP_ADMIN_PASSWORD=atlas-dev-admin

# --- Web (apps/web) ---
# Where the Next.js *server* reaches the API. Browser requests go through the
# app's own /api/atlas proxy, so this never needs to be browser-reachable —
# in Docker it is http://api:8000.
ATLAS_API_URL=http://localhost:8000
